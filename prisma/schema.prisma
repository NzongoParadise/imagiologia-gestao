generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Utilizador {
  id                          Int                    @id @default(autoincrement())
  nome                        String
  email                       String                 @unique
  password                    String
  role                        String                 @default("TECNICO")
  ativo                       Boolean                @default(true)
  ultimoVisto                 DateTime?              @map("ultimo_visto")
  createdAt                   DateTime               @default(now())
  updatedAt                   DateTime               @updatedAt
  historico                   Historico[]
  exames                      Exame[]                @relation("ExamesRealizados")
  examesSolicitados           Exame[]                @relation("ExamesSolicitados")
  laudosAssinados             Laudo[]                @relation("LaudosAssinados")
  notificacoes                Notificacao[]
  anotacoes                   Anotacao[]
  turnosCriados               Turno[]                @relation("TurnosCriados")
  conversasCriadas            Conversa[]             @relation("ConversasCriadas")
  participacoes               ConversaParticipante[]
  mensagens                   Mensagem[]
  backups                     Backup[]
  chamadasFeitas              ChamadaVoz[]           @relation("ChamadasFeitas")
  chamadasRecebidas           ChamadaVoz[]           @relation("ChamadasRecebidas")
  sinaisVoip                  SinalVoip[]
  analisesIA                  AnaliseIA[]
  comparacoesCriadas          ComparacaoExame[]
  contradicoesCriadas         Contradicao[]          @relation("ContradicaoCriador")
  contradicoesResolvidas      Contradicao[]          @relation("ContradicaoResolver")
  segundasOpinioesSolicitadas SegundaOpiniao[]       @relation("SegundaOpiniaoSolicitante")
  segundasOpinioesAnalisadas  SegundaOpiniao[]       @relation("SegundaOpiniaoRadiologista")
  predicoesCriadas            PredicaoServico[]
  sessoesIA                   SessaoIA[]
  reunioesCriadas             ReuniaoClinica[]
  reuniaoParticipacoes        ReuniaoParticipante[]
  reuniaoDecisoes             ReuniaoDecisao[]
  atendimentosCriados         Atendimento[]          @relation("AtendimentosCriados")
  atendimentosConsultas       AtendimentoConsulta[]  @relation("AtendimentoConsultaCriado")
  atendimentosUrgencias       AtendimentoUrgencia[]  @relation("AtendimentoUrgenciaCriado")
  consultasComoMedico         AtendimentoConsulta[]  @relation("AtendimentoConsultaMedico")
  urgenciasComoMedico         AtendimentoUrgencia[]  @relation("AtendimentoUrgenciaMedico")
  triagensEnfermeiro          Triagem[]              @relation("TriagemEnfermeiro")
  encaminhamentosCriados      Encaminhamento[]       @relation("EncaminhamentosCriados")
  senhasEmitidas              SenhaAtendimento[]     @relation("SenhasEmitidas")
  filasGerenciadas            FilaAtendimento[]      @relation("FilasGerenciadas")
  classificacoesRisco         ClassificacaoRisco[]   @relation("ClassificacoesRiscoCriadas")
  agendamentosMedicos         AgendamentoConsulta[]  @relation("AgendamentoConsultaMedico")
  agendamentosCriadosConsulta AgendamentoConsulta[]  @relation("AgendamentoConsultaCriado")
  responsaveisCriados         Responsavel[]          @relation("ResponsaveisCriados")
  pedidosExameCriados         PedidoExame[]          @relation("PedidosExameCriados")
  receitasCriadas             Receita[]              @relation("ReceitasCriadas")
}

model Paciente {
  id                      Int                   @id @default(autoincrement())
  numeroProcesso          String                @unique @map("numero_processo")
  nome                    String
  dataNascimento          DateTime?             @map("data_nascimento")
  sexo                    String?               @map("sexo")
  telefone                String?
  email                   String?
  endereco                String?               @map("endereco")
  documento               String?               @map("documento")
  nif                     String?
  bi                      String?
  foto                    String?
  observacoes             String?
  createdAt               DateTime              @default(now()) @map("criado_em")
  updatedAt               DateTime              @updatedAt @map("atualizado_em")
  exames                  Exame[]
  historico               Historico[]
  notificacoes            Notificacao[]
  anotacoes               Anotacao[]
  reunioes                ReuniaoClinica[]
  atendimentos            Atendimento[]
  atendimentosConsulta    AtendimentoConsulta[]
  atendimentosUrgencia    AtendimentoUrgencia[]
  triagens                Triagem[]
  encaminhamentosEnviados Encaminhamento[]      @relation("EncaminhamentosEnviados")
  senhas                  SenhaAtendimento[]    @relation("SenhasPaciente")
  pedidosExame            PedidoExame[]
  receitas                Receita[]

  @@map("pacientes")
}

// ===========================================================================
// MÓDULO 01 — ATENDIMENTO (Consultas e Urgências)
// ===========================================================================

// ---------------------------------------------------------------------------
// Especialidade (consultas)
// ---------------------------------------------------------------------------
model Especialidade {
  id          Int         @id @default(autoincrement())
  nome        String      @unique
  descricao   String?
  ativo       Boolean     @default(true)
  criadoPorId Int?        @map("criado_por_id")
  criadoEm    DateTime    @default(now()) @map("criado_em")
  atendimentos        Atendimento[]
  atendimentosConsulta AtendimentoConsulta[]
  agendamentos        AgendamentoConsulta[]
  filas               FilaAtendimento[]

  @@index([ativo])
  @@map("especialidades")
}

// ---------------------------------------------------------------------------
// Banco de Urgência (BUM | BUP | BUCO)
// ---------------------------------------------------------------------------
model BancoUrgencia {
  id          Int         @id @default(autoincrement())
  nome        String      @unique
  tipo        String      @map("tipo") // BUM | BUP | BUCO
  descricao   String?
  ativo       Boolean     @default(true)
  criadoPorId Int?        @map("criado_por_id")
  criadoEm    DateTime    @default(now()) @map("criado_em")
  urgencias   AtendimentoUrgencia[]

  @@index([tipo])
  @@index([ativo])
  @@map("bancos_urgencia")
}

// ---------------------------------------------------------------------------
// Responsável (acompanhante/representante do paciente)
// ---------------------------------------------------------------------------
model Responsavel {
  id          Int         @id @default(autoincrement())
  nome        String
  parentesco  String?     // pai | mae | conjugue | filho | tutor | outro
  telefone    String?
  email       String?
  observacoes String?
  pacienteId  Int?        @map("paciente_id")
  criadoPorId Int?        @map("criado_por_id")
  criadoEm    DateTime    @default(now()) @map("criado_em")

  criadoPor Utilizador? @relation("ResponsaveisCriados", fields: [criadoPorId], references: [id])

  @@index([pacienteId])
  @@map("responsaveis")
}

// ---------------------------------------------------------------------------
// Atendimento (base comum Consulta/Urgência)
// ---------------------------------------------------------------------------
model Atendimento {
  id              Int      @id @default(autoincrement())
  codigo          String   @unique @map("codigo") // ex: AT-2026-0001
  tipo            String   @map("tipo") // CONSULTA | URGENCIA
  pacienteId      Int      @map("paciente_id")
  estado          String   @default("AGUARDANDO") // AGUARDANDO | EM_TRIAGEM | EM_ATENDIMENTO | CONCLUIDO | CANCELADO | ENCAMINHADO
  especialidadeId Int?     @map("especialidade_id")
  prioridade      String   @default("Normal") // Normal | Prioridade | Urgente
  origem          String?  @map("origem") // rececao | balcao | telefono | outra
  procedenciaId   Int?     @map("procedencia_id")
  criadoPorId     Int?     @map("criado_por_id")
  criadoEm        DateTime @default(now()) @map("criado_em")
  atualizadoEm    DateTime @updatedAt @map("atualizado_em")

  paciente        Paciente             @relation(fields: [pacienteId], references: [id])
  criadoPor       Utilizador?          @relation("AtendimentosCriados", fields: [criadoPorId], references: [id])
  especialidade   Especialidade?       @relation(fields: [especialidadeId], references: [id])
  consulta        AtendimentoConsulta?
  urgencia        AtendimentoUrgencia?
  triagem         Triagem?
  filaAtendimento FilaAtendimento?
  senha           SenhaAtendimento?
  encaminhamentos Encaminhamento[]
  pedidosExame     PedidoExame[]
  receitas         Receita[]

  @@index([pacienteId])
  @@index([tipo])
  @@index([estado])
  @@index([especialidadeId])
  @@index([criadoEm])
  @@map("atendimentos")
}

// ---------------------------------------------------------------------------
// Atendimento — Consulta
// ---------------------------------------------------------------------------
model AtendimentoConsulta {
  id              Int       @id @default(autoincrement())
  atendimentoId   Int       @unique @map("atendimento_id")
  pacienteId      Int       @map("paciente_id")
  agendamentoId   Int?      @unique @map("agendamento_id")
  especialidadeId Int?      @map("especialidade_id")
  medicoId        Int?      @map("medico_id")
  tipoConsulta    String?   @map("tipo_consulta") // primeira | retorno | revisao | outro
  motivo          String?
  sinaisSintomas  String?   @map("sinais_sintomas")
  diagnostico     String?
  prescricao      String?
  observacoes     String?
  iniciadoEm      DateTime? @map("iniciado_em")
  concluidoEm     DateTime? @map("concluido_em")
  criadoPorId     Int?      @map("criado_por_id")
  criadoEm        DateTime  @default(now()) @map("criado_em")

  atendimento  Atendimento          @relation(fields: [atendimentoId], references: [id], onDelete: Cascade)
  paciente     Paciente             @relation(fields: [pacienteId], references: [id])
  especialidade Especialidade?      @relation(fields: [especialidadeId], references: [id])
  medico       Utilizador?          @relation("AtendimentoConsultaMedico", fields: [medicoId], references: [id])
  criadoPor    Utilizador?          @relation("AtendimentoConsultaCriado", fields: [criadoPorId], references: [id])
  agendamento  AgendamentoConsulta? @relation(fields: [agendamentoId], references: [id])

  @@index([pacienteId])
  @@index([especialidadeId])
  @@index([iniciadoEm])
  @@map("atendimentos_consulta")
}

// ---------------------------------------------------------------------------
// Atendimento — Urgência (BUM | BUP | BUCO)
// ---------------------------------------------------------------------------
model AtendimentoUrgencia {
  id                Int       @id @default(autoincrement())
  atendimentoId     Int       @unique @map("atendimento_id")
  pacienteId        Int       @map("paciente_id")
  bancoUrgenciaId   Int?      @map("banco_urgencia_id")
  classificacaoId   Int?      @map("classificacao_id")
  queixaPrincipal   String?   @map("queixa_principal")
  horaChegada       DateTime  @default(now()) @map("hora_chegada")
  medicoId          Int?      @map("medico_id")
  diagnostico       String?
  conduta           String?
  evolucao          String?
  altaTipo          String?   @map("alta_tipo") // alta | internamento | transferencia | observacao
  altaJustificativa String?   @map("alta_justificativa")
  concluidoEm       DateTime? @map("concluido_em")
  criadoPorId       Int?      @map("criado_por_id")
  criadoEm          DateTime  @default(now()) @map("criado_em")

  atendimento   Atendimento         @relation(fields: [atendimentoId], references: [id], onDelete: Cascade)
  paciente      Paciente            @relation(fields: [pacienteId], references: [id])
  bancoUrgencia BancoUrgencia?      @relation(fields: [bancoUrgenciaId], references: [id])
  medico        Utilizador?         @relation("AtendimentoUrgenciaMedico", fields: [medicoId], references: [id])
  criadoPor     Utilizador?         @relation("AtendimentoUrgenciaCriado", fields: [criadoPorId], references: [id])
  classificacao ClassificacaoRisco? @relation(fields: [classificacaoId], references: [id])

  @@index([pacienteId])
  @@index([bancoUrgenciaId])
  @@index([horaChegada])
  @@map("atendimentos_urgencia")
}

// ---------------------------------------------------------------------------
// Triagem (enfermagem — classificação de risco)
// ---------------------------------------------------------------------------
model Triagem {
  id               Int      @id @default(autoincrement())
  atendimentoId    Int      @unique @map("atendimento_id")
  pacienteId       Int      @map("paciente_id")
  classificacaoId  Int      @map("classificacao_id")
  enfermeiroId     Int?     @map("enfermeiro_id")
  sinaisVitaisJson Json?    @map("sinais_vitais_json")
  sintomas         String?
  alergias         String?
  historicoDoenca  String?  @map("historico_doenca")
  medicacao        String?
  observacoes      String?
  realizadoEm      DateTime @default(now()) @map("realizado_em")

  atendimento   Atendimento        @relation(fields: [atendimentoId], references: [id], onDelete: Cascade)
  paciente      Paciente           @relation(fields: [pacienteId], references: [id])
  classificacao ClassificacaoRisco @relation(fields: [classificacaoId], references: [id])
  enfermeiro    Utilizador?        @relation("TriagemEnfermeiro", fields: [enfermeiroId], references: [id])

  @@index([pacienteId])
  @@index([realizadoEm])
  @@map("triagens")
}

// ---------------------------------------------------------------------------
// Classificação de Risco (configurável)
// ---------------------------------------------------------------------------
model ClassificacaoRisco {
  id          Int      @id @default(autoincrement())
  nome        String   @unique
  cor         String   @default("verde") // vermelho | laranja | amarelo | verde | azul
  nivel       Int      @default(1)
  descricao   String?
  tempoMaximo Int?     @map("tempo_maximo") // minutos de meta de atendimento
  ativo       Boolean  @default(true)
  criadoPorId Int?     @map("criado_por_id")
  criadoEm    DateTime @default(now()) @map("criado_em")

  criadoPor Utilizador?           @relation("ClassificacoesRiscoCriadas", fields: [criadoPorId], references: [id])
  triagens  Triagem[]
  urgencias AtendimentoUrgencia[]

  @@index([nivel])
  @@map("classificacoes_risco")
}

// ---------------------------------------------------------------------------
// Fila de Atendimento (por especialidade/tipo)
// ---------------------------------------------------------------------------
model FilaAtendimento {
  id              Int       @id @default(autoincrement())
  atendimentoId   Int       @unique @map("atendimento_id")
  tipoFila        String    @map("tipo_fila") // CONSULTA | URGENCIA
  especialidadeId Int?      @map("especialidade_id")
  posicao         Int       @default(0)
  status          String    @default("EM_FILA") // EM_FILA | CHAMADO | EM_ATENDIMENTO | CONCLUIDO | CANCELADO
  criadoPorId     Int?      @map("criado_por_id")
  criadoEm        DateTime  @default(now()) @map("criado_em")
  chamadoEm       DateTime? @map("chamado_em")
  atendidoEm      DateTime? @map("atendido_em")

  atendimento  Atendimento    @relation(fields: [atendimentoId], references: [id], onDelete: Cascade)
  criadoPor    Utilizador?    @relation("FilasGerenciadas", fields: [criadoPorId], references: [id])
  especialidade Especialidade? @relation(fields: [especialidadeId], references: [id])

  @@index([tipoFila])
  @@index([especialidadeId])
  @@index([status])
  @@index([posicao])
  @@map("filas_atendimento")
}

// ---------------------------------------------------------------------------
// Senha de Atendimento (sistema de senhas)
// ---------------------------------------------------------------------------
model SenhaAtendimento {
  id            Int       @id @default(autoincrement())
  codigo        String    @unique // ex: C-001, U-001
  tipo          String    @map("tipo") // CONSULTA | URGENCIA
  pacienteId    Int       @map("paciente_id")
  atendimentoId Int?      @unique @map("atendimento_id")
  emitidaPorId  Int?      @map("emitida_por_id")
  status        String    @default("EM_ESPERA") // EM_ESPERA | CHAMADA | EM_ATENDIMENTO | CONCLUIDA | CANCELADA
  emitidaEm     DateTime  @default(now()) @map("emitida_em")
  chamadaEm     DateTime? @map("chamada_em")

  paciente    Paciente     @relation("SenhasPaciente", fields: [pacienteId], references: [id])
  emitidaPor  Utilizador?  @relation("SenhasEmitidas", fields: [emitidaPorId], references: [id])
  atendimento Atendimento? @relation(fields: [atendimentoId], references: [id])

  @@index([pacienteId])
  @@index([tipo])
  @@index([status])
  @@index([emitidaEm])
  @@map("senhas_atendimento")
}

// ---------------------------------------------------------------------------
// Encaminhamento (destino + motivo)
// ---------------------------------------------------------------------------
model Encaminhamento {
  id            Int       @id @default(autoincrement())
  atendimentoId Int       @map("atendimento_id")
  pacienteId    Int       @map("paciente_id")
  origemTipo    String    @map("origem_tipo") // CONSULTA | URGENCIA
  destino       String    @map("destino") // especialidade | setor | instituicao
  tipoDestino   String?   @map("tipo_destino") // interno | externo
  motivo        String
  prioridade    String    @default("Normal")
  estado        String    @default("PENDENTE") // PENDENTE | AGUARDANDO | ACEITE | CONCLUIDO | RECUSADO | CANCELADO
  criadoPorId   Int?      @map("criado_por_id")
  criadoEm      DateTime  @default(now()) @map("criado_em")
  aceiteEm      DateTime? @map("aceite_em")
  concluidoEm   DateTime? @map("concluido_em")

  atendimento Atendimento @relation(fields: [atendimentoId], references: [id], onDelete: Cascade)
  paciente    Paciente    @relation("EncaminhamentosEnviados", fields: [pacienteId], references: [id])
  criadoPor   Utilizador? @relation("EncaminhamentosCriados", fields: [criadoPorId], references: [id])

  @@index([atendimentoId])
  @@index([pacienteId])
  @@index([destino])
  @@index([estado])
  @@map("encaminhamentos")
}

// ---------------------------------------------------------------------------
// Pedidos de exame e receitas clinicas
// ---------------------------------------------------------------------------
model PedidoExame {
  id            Int       @id @default(autoincrement())
  atendimentoId Int       @map("atendimento_id")
  pacienteId    Int       @map("paciente_id")
  tipoExameId   Int       @map("tipo_exame_id")
  prioridade    String    @default("Normal")
  justificativa String?
  estado        String    @default("PENDENTE")
  criadoPorId   Int?      @map("criado_por_id")
  criadoEm      DateTime  @default(now()) @map("criado_em")

  atendimento Atendimento @relation(fields: [atendimentoId], references: [id], onDelete: Cascade)
  paciente    Paciente    @relation(fields: [pacienteId], references: [id])
  tipoExame   TipoExame  @relation(fields: [tipoExameId], references: [id])
  criadoPor   Utilizador? @relation("PedidosExameCriados", fields: [criadoPorId], references: [id])

  @@index([atendimentoId])
  @@index([pacienteId])
  @@index([estado])
  @@map("pedidos_exame")
}

model Receita {
  id            Int       @id @default(autoincrement())
  atendimentoId Int       @map("atendimento_id")
  pacienteId    Int       @map("paciente_id")
  observacoes   String?
  criadoPorId   Int?      @map("criado_por_id")
  criadoEm      DateTime  @default(now()) @map("criado_em")

  atendimento  Atendimento  @relation(fields: [atendimentoId], references: [id], onDelete: Cascade)
  paciente     Paciente     @relation(fields: [pacienteId], references: [id])
  criadoPor    Utilizador?  @relation("ReceitasCriadas", fields: [criadoPorId], references: [id])
  medicamentos ReceitaMedicamento[]

  @@index([atendimentoId])
  @@index([pacienteId])
  @@map("receitas")
}

model ReceitaMedicamento {
  id           Int      @id @default(autoincrement())
  receitaId    Int      @map("receita_id")
  medicamento  String
  dosagem      String?
  via          String?
  frequencia   String?
  duracaoDias  Int?     @map("duracao_dias")
  quantidade   String?
  observacoes  String?
  ordem        Int      @default(0)

  receita Receita @relation(fields: [receitaId], references: [id], onDelete: Cascade)

  @@index([receitaId])
  @@map("receita_medicamentos")
}

// ---------------------------------------------------------------------------
// Agendamento de Consulta
// ---------------------------------------------------------------------------
model AgendamentoConsulta {
  id              Int      @id @default(autoincrement())
  pacienteId      Int      @map("paciente_id")
  atendimentoId   Int?     @map("atendimento_id")
  especialidadeId Int?
  medicoId        Int?     @map("medico_id")
  dataHora        DateTime @map("data_hora")
  duracaoMin      Int      @default(30) @map("duracao_min")
  estado          String   @default("AGENDADO") // AGENDADO | CONFIRMADO | CHEGOU | CANCELADO | CONCLUIDO
  observacoes     String?
  criadoPorId     Int?     @map("criado_por_id")
  criadoEm        DateTime @default(now()) @map("criado_em")

  medico        Utilizador?          @relation("AgendamentoConsultaMedico", fields: [medicoId], references: [id])
  criadoPor     Utilizador?          @relation("AgendamentoConsultaCriado", fields: [criadoPorId], references: [id])
  especialidade Especialidade?       @relation(fields: [especialidadeId], references: [id])
  consulta      AtendimentoConsulta?

  @@index([pacienteId])
  @@index([especialidadeId])
  @@index([dataHora])
  @@index([estado])
  @@map("agendamentos_consulta")
}

model Tecnico {
  id            Int      @id @default(autoincrement())
  nome          String
  email         String?
  telefone      String?
  especialidade String?
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  exames        Exame[]
  turnos        Turno[]
}

model Procedencia {
  id        Int      @id @default(autoincrement())
  nome      String   @unique
  descricao String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  exames    Exame[]
}

model TipoExame {
  id         Int      @id @default(autoincrement())
  nome       String   @unique
  modalidade String?
  descricao  String?
  duracaoMin Int?
  preco      Float?
  ativo      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  exames     Exame[]
  pedidos    PedidoExame[]
}

model Exame {
  id                  Int      @id @default(autoincrement())
  codigo              String?  @unique @map("codigo")
  pacienteId          Int      @map("paciente_id")
  tipoExameId         Int      @map("tipo_exame_id")
  tecnicoId           Int?     @map("tecnico_id")
  procedenciaId       Int?     @map("procedencia_id")
  medicoSolicitante   String?  @map("medico_solicitante")
  observacao          String?  @map("observacao")
  estado              String   @default("Solicitado")
  prioridade          String   @default("Normal")
  diagnosticoClinico  String?  @map("diagnostico_clinico")
  justificacaoClinica String?  @map("justificacao_clinica")
  dataExame           DateTime @default(now()) @map("data_exame")
  createdAt           DateTime @default(now()) @map("criado_em")
  updatedAt           DateTime @updatedAt @map("atualizado_em")

  paciente            Paciente          @relation(fields: [pacienteId], references: [id])
  tipoExame           TipoExame         @relation(fields: [tipoExameId], references: [id])
  tecnico             Tecnico?          @relation(fields: [tecnicoId], references: [id])
  procedencia         Procedencia?      @relation(fields: [procedenciaId], references: [id])
  realizadoPor        Utilizador?       @relation("ExamesRealizados", fields: [realizadoPorId], references: [id])
  realizadoPorId      Int?              @map("realizado_por_id")
  solicitadoPor       Utilizador?       @relation("ExamesSolicitados", fields: [solicitadoPorId], references: [id])
  solicitadoPorId     Int?              @map("solicitado_por_id")
  laudos              Laudo[]
  imagens             Imagem[]
  historico           Historico[]
  notificacoes        Notificacao[]
  anotacoes           Anotacao[]
  analisesIA          AnaliseIA[]
  regioes             ExameRegiao[]
  comparacoesBase     ComparacaoExame[] @relation("ComparacaoBase")
  comparacoesVar      ComparacaoExame[] @relation("ComparacaoComparado")
  casosClinicos       CasoClinico[]
  contradicoes        Contradicao[]
  indicadores         IndicadorRegiao[]
  segundasOpinioes    SegundaOpiniao[]
  reunioesPartilhadas ReuniaoExame[]

  @@index([pacienteId])
  @@index([tipoExameId])
  @@index([tecnicoId])
  @@index([procedenciaId])
  @@index([dataExame])
  @@index([estado])
  @@index([prioridade])
  @@map("exames")
}

model AnaliseIA {
  id                   Int      @id @default(autoincrement())
  exameId              Int      @map("exame_id")
  utilizadorId         Int?     @map("utilizador_id")
  imagemId             Int?     @map("imagem_id")
  modelo               String   @default("TorchXRayVision")
  diagnosticoPrincipal String?  @map("diagnostico_principal")
  confianca            Float    @default(0)
  achados              Json
  resumo               String
  resultadoJson        Json     @map("resultado_json")
  heatmap              String?
  preLaudo             String?
  status               String   @default("concluido")
  tempoProcessamento   Float    @default(0) @map("tempo_processamento")
  createdAt            DateTime @default(now()) @map("criado_em")
  updatedAt            DateTime @updatedAt @map("atualizado_em")

  exame      Exame       @relation(fields: [exameId], references: [id], onDelete: Cascade)
  utilizador Utilizador? @relation(fields: [utilizadorId], references: [id])

  @@index([exameId])
  @@index([utilizadorId])
  @@map("analises_ia")
}

model Laudo {
  id              Int       @id @default(autoincrement())
  exameId         Int       @map("exame_id")
  conteudo        String
  medicoAssinouId Int?      @map("medico_assinou_id")
  assinado        Boolean   @default(false)
  assinatura      String?
  assinadoEm      DateTime? @map("assinado_em")
  createdAt       DateTime  @default(now()) @map("criado_em")
  updatedAt       DateTime  @updatedAt @map("atualizado_em")

  exame         Exame       @relation(fields: [exameId], references: [id])
  medicoAssinou Utilizador? @relation("LaudosAssinados", fields: [medicoAssinouId], references: [id])

  @@unique([exameId])
  @@index([medicoAssinouId])
  @@map("laudos")
}

model Imagem {
  id           Int      @id @default(autoincrement())
  exameId      Int
  filename     String
  originalName String
  mimeType     String
  tamanho      Int
  path         String
  dados        Bytes?
  createdAt    DateTime @default(now())

  exame Exame @relation(fields: [exameId], references: [id])

  @@index([exameId])
}

model Configuracao {
  id    Int    @id @default(autoincrement())
  chave String @unique
  valor String

  @@map("configuracoes")
}

model Notificacao {
  id           Int      @id @default(autoincrement())
  titulo       String
  mensagem     String
  tipo         String   @default("info")
  lida         Boolean  @default(false)
  utilizadorId Int?
  exameId      Int?
  pacienteId   Int?
  createdAt    DateTime @default(now()) @map("criado_em")

  utilizador Utilizador? @relation(fields: [utilizadorId], references: [id])
  exame      Exame?      @relation(fields: [exameId], references: [id])
  paciente   Paciente?   @relation(fields: [pacienteId], references: [id])

  @@index([utilizadorId])
  @@index([lida])
  @@index([createdAt])
  @@map("notificacoes")
}

model Historico {
  id           Int      @id @default(autoincrement())
  acao         String
  entidade     String
  entidadeId   Int?
  descricao    String?
  utilizadorId Int?
  pacienteId   Int?
  exameId      Int?
  createdAt    DateTime @default(now())

  utilizador Utilizador? @relation(fields: [utilizadorId], references: [id])
  paciente   Paciente?   @relation(fields: [pacienteId], references: [id])
  exame      Exame?      @relation(fields: [exameId], references: [id])

  @@index([createdAt])
  @@index([entidade, entidadeId])
}

model Anotacao {
  id           Int      @id @default(autoincrement())
  conteudo     String
  tipo         String   @default("geral")
  entidade     String?
  entidadeId   Int?
  utilizadorId Int?
  exameId      Int?
  pacienteId   Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  utilizador Utilizador? @relation(fields: [utilizadorId], references: [id])
  exame      Exame?      @relation(fields: [exameId], references: [id])
  paciente   Paciente?   @relation(fields: [pacienteId], references: [id])

  @@index([createdAt])
  @@index([entidade, entidadeId])
  @@map("anotacoes")
}

model Turno {
  id          Int      @id @default(autoincrement())
  tecnicoId   Int      @map("tecnico_id")
  data        DateTime
  horaInicio  String   @map("hora_inicio")
  horaFim     String   @map("hora_fim")
  tipo        String   @default("Normal")
  estado      String   @default("Agendado")
  observacao  String?
  createdById Int?     @map("criado_por_id")
  createdAt   DateTime @default(now()) @map("criado_em")
  updatedAt   DateTime @updatedAt @map("atualizado_em")

  tecnico   Tecnico     @relation(fields: [tecnicoId], references: [id])
  createdBy Utilizador? @relation("TurnosCriados", fields: [createdById], references: [id])

  @@index([tecnicoId])
  @@index([data])
  @@map("turnos")
}

model Conversa {
  id          Int      @id @default(autoincrement())
  titulo      String?
  criadaPorId Int?     @map("criada_por_id")
  createdAt   DateTime @default(now()) @map("criado_em")
  updatedAt   DateTime @updatedAt @map("atualizado_em")

  criadaPor     Utilizador?            @relation("ConversasCriadas", fields: [criadaPorId], references: [id])
  participantes ConversaParticipante[]
  mensagens     Mensagem[]
  chamadasVoz   ChamadaVoz[]

  @@index([criadaPorId])
  @@index([updatedAt])
  @@map("conversas")
}

model ConversaParticipante {
  id           Int       @id @default(autoincrement())
  conversaId   Int       @map("conversa_id")
  utilizadorId Int       @map("utilizador_id")
  lidaEm       DateTime? @map("lida_em")
  createdAt    DateTime  @default(now()) @map("criado_em")

  conversa   Conversa   @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  utilizador Utilizador @relation(fields: [utilizadorId], references: [id], onDelete: Cascade)

  @@unique([conversaId, utilizadorId])
  @@index([utilizadorId])
  @@map("conversa_participantes")
}

model Mensagem {
  id           Int      @id @default(autoincrement())
  conversaId   Int      @map("conversa_id")
  utilizadorId Int      @map("utilizador_id")
  conteudo     String
  createdAt    DateTime @default(now()) @map("criado_em")

  conversa   Conversa   @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  utilizador Utilizador @relation(fields: [utilizadorId], references: [id], onDelete: Cascade)

  @@index([conversaId])
  @@index([utilizadorId])
  @@index([createdAt])
  @@map("mensagens")
}

model Backup {
  id          Int         @id @default(autoincrement())
  nome        String
  tipo        String      @default("manual") // manual | automatico
  tamanho     Int         @default(0) // bytes do JSON comprimido
  numRegistos Int         @default(0)
  dados       Bytes // JSON comprimido (gzip)
  criadoPorId Int?
  criadoEm    DateTime    @default(now())
  criadoPor   Utilizador? @relation(fields: [criadoPorId], references: [id])

  @@index([criadoEm])
  @@index([criadoPorId])
  @@map("backups")
}

// ---------------------------------------------------------------------------
// Chamadas de Voz Internas (VoIP)
// ---------------------------------------------------------------------------

model ChamadaVoz {
  id          Int       @id @default(autoincrement())
  chamadorId  Int       @map("chamador_id")
  receptorId  Int       @map("receptor_id")
  conversaId  Int?      @map("conversa_id")
  estado      String    @default("A_CHAMAR") // A_CHAMAR | EM_CURSO | TERMINADA | REJEITADA | NAO_ATENDIDA | CANCELADA
  iniciadoEm  DateTime  @default(now()) @map("iniciado_em")
  aceiteEm    DateTime? @map("aceite_em")
  terminadoEm DateTime? @map("terminado_em")
  duracaoSeg  Int       @default(0) @map("duracao_seg")
  motivoFim   String?   @map("motivo_fim")

  chamador Utilizador  @relation("ChamadasFeitas", fields: [chamadorId], references: [id])
  receptor Utilizador  @relation("ChamadasRecebidas", fields: [receptorId], references: [id])
  conversa Conversa?   @relation(fields: [conversaId], references: [id], onDelete: SetNull)
  sinais   SinalVoip[]

  @@index([chamadorId])
  @@index([receptorId])
  @@index([estado])
  @@index([iniciadoEm])
  @@map("chamadas_voz")
}

model SinalVoip {
  id           Int      @id @default(autoincrement())
  chamadaId    Int      @map("chamada_id")
  utilizadorId Int      @map("utilizador_id")
  tipo         String // offer | answer | ice
  conteudo     String // JSON com SDP ou ICE candidate
  createdAt    DateTime @default(now()) @map("criado_em")

  chamada    ChamadaVoz @relation(fields: [chamadaId], references: [id], onDelete: Cascade)
  utilizador Utilizador @relation(fields: [utilizadorId], references: [id])

  @@index([chamadaId, createdAt])
  @@map("sinais_voip")
}

// ===========================================================================
// PORTAL MÉDICO COGNITIVO — Módulos de Inteligência Clínica
// ===========================================================================

// ---------------------------------------------------------------------------
// Regiões Anatómicas (Digital Twin Radiológico)
// ---------------------------------------------------------------------------
model RegiaoAnatomica {
  id          Int               @id @default(autoincrement())
  nome        String
  nomePT      String            @map("nome_pt") // Nome em português para UI
  grupo       String            @default("geral") // cabeca | torax | abdomen | pelve | membros | coluna
  ordem       Int               @default(0)
  riscoBase   Int               @default(0) // 0-100 indicador de risco
  descricao   String?
  icone       String?
  ativo       Boolean           @default(true)
  createdAt   DateTime          @default(now()) @map("criado_em")
  exames      ExameRegiao[]
  indicadores IndicadorRegiao[]
  comparacoes ComparacaoExame[]
  casos       CasoClinico[]

  @@index([grupo])
  @@index([ordem])
  @@map("regioes_anatomicas")
}

model IndicadorRegiao {
  id         Int      @id @default(autoincrement())
  regiaoId   Int      @map("regiao_id")
  tipo       String // risco | evolucao | volume | densidade
  valor      Float
  nivel      String   @default("normal") // normal | alerta | critico
  observacao String?
  medidoEm   DateTime @default(now()) @map("medido_em")
  exameId    Int?     @map("exame_id")

  regiao RegiaoAnatomica @relation(fields: [regiaoId], references: [id], onDelete: Cascade)
  exame  Exame?          @relation(fields: [exameId], references: [id])

  @@index([regiaoId])
  @@index([medidoEm])
  @@map("indicadores_regiao")
}

model ExameRegiao {
  id        Int      @id @default(autoincrement())
  exameId   Int      @map("exame_id")
  regiaoId  Int      @map("regiao_id")
  createdAt DateTime @default(now()) @map("criado_em")

  exame  Exame           @relation(fields: [exameId], references: [id], onDelete: Cascade)
  regiao RegiaoAnatomica @relation(fields: [regiaoId], references: [id], onDelete: Cascade)

  @@unique([exameId, regiaoId])
  @@index([regiaoId])
  @@map("examens_regioes")
}

// ---------------------------------------------------------------------------
// Comparação Radiológica (Evolução + Detector de Mudanças)
// ---------------------------------------------------------------------------
model ComparacaoExame {
  id            Int      @id @default(autoincrement())
  exameBaseId   Int      @map("exame_base_id")
  exameComparar Int      @map("exame_comparado_id")
  regiaoId      Int?     @map("regiao_id")
  tipo          String   @default("evolucao") // evolucao | mudanca | followup
  resultadoJson Json     @map("resultado_json") // regiões, diferenças, medidas
  conclusao     String?
  novasLesoes   Int      @default(0) @map("novas_lesoes")
  regressao     Int      @default(0)
  progressao    Int      @default(0)
  estabilidade  Int      @default(0)
  criadoPorId   Int?     @map("criado_por_id")
  createdAt     DateTime @default(now()) @map("criado_em")

  exameBase Exame            @relation("ComparacaoBase", fields: [exameBaseId], references: [id], onDelete: Cascade)
  exameVar  Exame            @relation("ComparacaoComparado", fields: [exameComparar], references: [id], onDelete: Cascade)
  regiao    RegiaoAnatomica? @relation(fields: [regiaoId], references: [id])
  criadoPor Utilizador?      @relation(fields: [criadoPorId], references: [id])

  @@index([exameBaseId])
  @@index([exameComparar])
  @@index([criadoPorId])
  @@map("comparacoes_exame")
}

// ---------------------------------------------------------------------------
// Memória Clínica Hospitalar (casos semelhantes — ANONIMIZADOS)
// ---------------------------------------------------------------------------
model CasoClinico {
  id                   Int      @id @default(autoincrement())
  codigoAnonimo        String   @unique @map("codigo_anonimo") // ex: CASO-2026-0001
  diagnosticoPrincipal String   @map("diagnostico_principal")
  modalidade           String?
  regiaoId             Int?     @map("regiao_id")
  faixaEtaria          String?  @map("faixa_etaria") // armazenado, não idade exata
  sexo                 String?
  laudoResumo          String?  @map("laudo_resumo")
  tratamento           String?
  desfecho             String? // recuperado | complicacao | obito | em_tratamento
  tempoRecuperacaoDias Int?     @map("tempo_recuperacao_dias")
  confirmado           Boolean  @default(true)
  descartado           Boolean  @default(false)
  origemExameId        Int?     @map("origem_exame_id")
  createdAt            DateTime @default(now()) @map("criado_em")

  regiao      RegiaoAnatomica? @relation(fields: [regiaoId], references: [id])
  origemExame Exame?           @relation(fields: [origemExameId], references: [id])

  @@index([diagnosticoPrincipal])
  @@index([modalidade])
  @@index([regiaoId])
  @@index([confirmado])
  @@map("casos_clinicos")
}

// ---------------------------------------------------------------------------
// Detector de Contradições (imagem x laudo x histórico)
// ---------------------------------------------------------------------------
model Contradicao {
  id             Int       @id @default(autoincrement())
  exameId        Int       @map("exame_id")
  tipo           String // imagem_laudo | laudo_historico | diagnostico_imagem
  severidade     String    @default("media") // baixa | media | alta | critica
  descricao      String
  detalheJson    Json?     @map("detalhe_json")
  estado         String    @default("aberta") // aberta | confirmada | descartada | resolvida
  criadoPorId    Int?      @map("criado_por_id")
  resolvidoPorId Int?      @map("resolvido_por_id")
  resolvidoEm    DateTime? @map("resolvido_em")
  createdAt      DateTime  @default(now()) @map("criado_em")

  exame        Exame       @relation(fields: [exameId], references: [id], onDelete: Cascade)
  criadoPor    Utilizador? @relation("ContradicaoCriador", fields: [criadoPorId], references: [id])
  resolvidoPor Utilizador? @relation("ContradicaoResolver", fields: [resolvidoPorId], references: [id])

  @@index([exameId])
  @@index([estado])
  @@index([severidade])
  @@map("contradicoes")
}

// ---------------------------------------------------------------------------
// Segunda Opinião
// ---------------------------------------------------------------------------
model SegundaOpiniao {
  id              Int       @id @default(autoincrement())
  exameId         Int       @map("exame_id")
  solicitadoPorId Int?      @map("solicitado_por_id")
  radiologistaId  Int?      @map("radiologista_id")
  motivo          String?
  estado          String    @default("solicitada") // solicitada | em_analise | concluida | cancelada
  laudoOriginal   String?   @map("laudo_original")
  laudoSegunda    String?   @map("laudo_segunda")
  coerente        Boolean?
  conclusao       String?
  solicitadoEm    DateTime  @default(now()) @map("solicitado_em")
  concluidoEm     DateTime? @map("concluido_em")

  exame         Exame       @relation(fields: [exameId], references: [id], onDelete: Cascade)
  solicitadoPor Utilizador? @relation("SegundaOpiniaoSolicitante", fields: [solicitadoPorId], references: [id])
  radiologista  Utilizador? @relation("SegundaOpiniaoRadiologista", fields: [radiologistaId], references: [id])

  @@index([exameId])
  @@index([estado])
  @@map("segundas_opinioes")
}

// ---------------------------------------------------------------------------
// Reunião Clínica (multidisciplinar + ata automática)
// ---------------------------------------------------------------------------
model ReuniaoClinica {
  id          Int      @id @default(autoincrement())
  titulo      String
  pacienteId  Int?     @map("paciente_id")
  descricao   String?
  estado      String   @default("agendada") // agendada | em_curso | concluida | cancelada
  dataHora    DateTime @map("data_hora")
  ata         String? // ata gerada automaticamente
  ataJson     Json?    @map("ata_json")
  criadoPorId Int?     @map("criado_por_id")
  createdAt   DateTime @default(now()) @map("criado_em")
  updatedAt   DateTime @updatedAt @map("atualizado_em")

  paciente          Paciente?             @relation(fields: [pacienteId], references: [id])
  criadoPor         Utilizador?           @relation(fields: [criadoPorId], references: [id])
  participantes     ReuniaoParticipante[]
  decisoes          ReuniaoDecisao[]
  examesPartilhados ReuniaoExame[]

  @@index([pacienteId])
  @@index([dataHora])
  @@index([estado])
  @@map("reunioes_clinicas")
}

model ReuniaoParticipante {
  id           Int      @id @default(autoincrement())
  reuniaoId    Int      @map("reuniao_id")
  utilizadorId Int      @map("utilizador_id")
  papel        String   @default("participante")
  confirmado   Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("criado_em")

  reuniao    ReuniaoClinica @relation(fields: [reuniaoId], references: [id], onDelete: Cascade)
  utilizador Utilizador     @relation(fields: [utilizadorId], references: [id], onDelete: Cascade)

  @@unique([reuniaoId, utilizadorId])
  @@index([utilizadorId])
  @@map("reuniao_participantes")
}

model ReuniaoDecisao {
  id          Int       @id @default(autoincrement())
  reuniaoId   Int       @map("reuniao_id")
  autorId     Int?      @map("autor_id")
  descricao   String
  responsavel Int?
  prazo       DateTime?
  estado      String    @default("pendente") // pendente | concluida | cancelada
  createdAt   DateTime  @default(now()) @map("criado_em")

  reuniao ReuniaoClinica @relation(fields: [reuniaoId], references: [id], onDelete: Cascade)
  autor   Utilizador?    @relation(fields: [autorId], references: [id])

  @@index([reuniaoId])
  @@index([estado])
  @@map("reuniao_decisoes")
}

model ReuniaoExame {
  id        Int      @id @default(autoincrement())
  reuniaoId Int      @map("reuniao_id")
  exameId   Int      @map("exame_id")
  createdAt DateTime @default(now()) @map("criado_em")

  reuniao ReuniaoClinica @relation(fields: [reuniaoId], references: [id], onDelete: Cascade)
  exame   Exame          @relation(fields: [exameId], references: [id], onDelete: Cascade)

  @@unique([reuniaoId, exameId])
  @@map("reuniao_exames")
}

// ---------------------------------------------------------------------------
// Previsão Inteligente (sobrecarga, fila, equipamentos, demanda)
// ---------------------------------------------------------------------------
model PredicaoServico {
  id          Int      @id @default(autoincrement())
  tipo        String // sobrecarga | fila | equipamento | ocupacao | tempo_espera | demanda
  periodo     String // dia | semana | mes
  parametros  Json?    @map("parametros")
  resultado   Json     @map("resultado")
  confianca   Float    @default(0)
  modelo      String   @default("prophet-ts")
  criadaPorId Int?     @map("criada_por_id")
  criadoEm    DateTime @default(now()) @map("criado_em")

  criadaPor Utilizador? @relation(fields: [criadaPorId], references: [id])

  @@index([tipo])
  @@index([periodo])
  @@index([criadoEm])
  @@map("predicoes_servico")
}

// ---------------------------------------------------------------------------
// Assistente Explicável / IA Generativa — sessões e mensagens
// ---------------------------------------------------------------------------
model SessaoIA {
  id           Int      @id @default(autoincrement())
  titulo       String   @default("Nova conversa")
  tipo         String   @default("assistente") // assistente | generativa | pesquisa
  utilizadorId Int?     @map("utilizador_id")
  contextoJson Json?    @map("contexto_json")
  createdAt    DateTime @default(now()) @map("criado_em")
  updatedAt    DateTime @updatedAt @map("atualizado_em")

  utilizador Utilizador?  @relation(fields: [utilizadorId], references: [id])
  mensagens  MensagemIA[]

  @@index([utilizadorId])
  @@index([updatedAt])
  @@map("sessoes_ia")
}

model MensagemIA {
  id           Int      @id @default(autoincrement())
  sessaoId     Int      @map("sessao_id")
  papel        String   @default("utilizador") // utilizador | assistente
  conteudo     String
  contextoJson Json?    @map("contexto_json")
  createdAt    DateTime @default(now()) @map("criado_em")

  sessao SessaoIA @relation(fields: [sessaoId], references: [id], onDelete: Cascade)

  @@index([sessaoId])
  @@index([createdAt])
  @@map("mensagens_ia")
}
