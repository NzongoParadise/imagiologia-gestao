# PostgreSQL / Neon
DATABASE_URL="postgresql://user:password@host:5432/database"

# NextAuth
AUTH_SECRET="substitua-por-segredo"
# (opcional) AUTH_URL="http://localhost:3000"

# Backend de IA (TorchXRayVision) - servico Python/FastAPI separado
# Deve apontar para o URL publico do backend de IA.
# Se nao estiver definido, o frontend usa analise heuristica local (nao e diagnostico medico).
AI_BACKEND_URL="http://localhost:8000"

# Token de autenticacao Bearer para o backend de IA (AI_BACKEND_TOKEN).
# Se definido, o backend exige o header "Authorization: Bearer <token>" em /api/analisar.
# O proxy /api/ia/analisar e o ml-service reencaminham este token automaticamente.
AI_BACKEND_TOKEN="substitua-por-token-secreto"

# (opcional) Origens CORS permitidas no backend (separadas por virgula).
# Ex.: AI_BACKEND_ORIGINS="https://seu-app.vercel.app,http://localhost:3000"
# AI_BACKEND_ORIGINS="*"
