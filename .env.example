# PostgreSQL / Neon
DATABASE_URL="postgresql://user:password@host:5432/database"

# NextAuth
AUTH_SECRET="substitua-por-segredo"
# (opcional) AUTH_URL="http://localhost:3000"

# Backend de IA (TorchXRayVision) - serviço Python/FastAPI separado
